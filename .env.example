# Copy to .env (never commit it) or set these in your platform's secret store.
# Every value below is a placeholder.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100
SUPPORT_NUMBER=+15555550101
PUBLIC_BASE_URL=https://calls.example.com
CALLER_NAME=Example Co
# Both required, 32+ characters each, when OUTBOUND_ENABLED=true.
CALLGATE_API_TOKEN=
AUDIT_HASH_KEY=
DATABASE_PATH=callgate.db
OUTBOUND_ENABLED=false
CALLS_PER_MINUTE=10
MAX_ATTEMPTS_PER_DAY=2
MIN_GAP_MINUTES=120
CALL_WINDOW_START=08:00
CALL_WINDOW_END=21:00
# Weekdays calls are allowed on: all, mon-fri, mon-sat, mon,wed,fri ...
CALL_DAYS=all
# Optional per-day window, HH:MM-HH:MM, overrides the one above for that day.
# CALL_WINDOW_SAT=10:00-17:00
# Local dates with no calls, comma separated, and/or a file (see examples/).
CALL_HOLIDAYS=
# CALL_HOLIDAYS_FILE=holidays.txt
CONSENT_MAX_AGE_DAYS=548
